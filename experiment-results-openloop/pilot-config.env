# Open-loop CAMPAIGN configuration (v2) — read by scripts/run-pilot-openloop.sh
# with OPENLOOP_RESULTS_DIR=experiment-results-openloop. Frozen together with
# runlist.txt when the first campaign run starts (.pilot-plan.meta).
#
# Differences from the 2026-10-05 pilot (experiment-results-pilot-openloop/),
# each fixing an issue that pilot exposed (pilot-openloop-report.md):
#   - admission control in both services (MAX_INFLIGHT_*): a pod sheds the
#     excess with an immediate 503 instead of collapsing, so /metrics, probes
#     and the request-rate signal survive overload
#   - auth test users are pre-authenticated during the reset, so the setup()
#     bcrypt burst can no longer scale H1/H2 before the warm-up
# Autoscaler manifests, thresholds, timings and stage shapes are unchanged.
LOAD_PROFILE_VERSION=open-loop-arr-v2
# Same :latest images as the closed-loop campaign; the admission-control code is
# mounted from a ConfigMap (ACR Tasks are not available in Indonesia Central).
SERVICE_IMAGE_TAG=
CODE_OVERLAY=true
PREAUTH_AUTH_TOKENS=true

# Admission-control cap per pod (MAX_INFLIGHT_REQUESTS). Rule: ceil(C x p99 at C)
# from the calibration ladder, then verified: no shedding at <= C, goodput holds
# above C. Verified by the v2 ladders and the smoke test (2026-10-06).
MAX_INFLIGHT_AUTH=22
MAX_INFLIGHT_SHIPPING=48

# Rates (req/s) — confirmed by the v2 calibration ladders (calibration/); same as
# the pilot and the smoke test (auth peak kept at 30 by the user).
AUTH_BASE_RATE=2
AUTH_PEAK_RATE=30
SHIPPING_BASE_RATE=10
SHIPPING_PEAK_RATE=105

# SLOs (ms) — unchanged from the pilot: auth ~ closed-loop B2 spike p95,
# shipping ~ 1.3 x closed-loop B2 p95.
AUTH_SLO_MS=1500
SHIPPING_SLO_MS=1200

REQUEST_TIMEOUT=5s
VU_FACTOR=1.5
K6_RESOURCES_AUTH=1000m,1Gi,2000m,4Gi
K6_RESOURCES_SHIPPING=1000m,1Gi,2000m,4Gi
PILOT_SEED=20261006
