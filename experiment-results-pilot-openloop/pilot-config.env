# Open-loop pilot configuration — read by scripts/run-pilot-openloop.sh.
# Frozen together with runlist.txt when the first pilot run starts (.pilot-plan.meta).
#
# Rates are req/s for ramping-arrival-rate (base = warm-up, peak = spike level).
# Set from the Phase 4 calibration ladders (calibration/*) and approved before
# any pilot run; the runner refuses to start a pilot run without them.
#
# auth-service (ladders 2026-10-05): C (B1 healthy max) = 10 req/s, B2 healthy
# ceiling = 40 req/s at SLO 1.5 s. Peak 30 = 75% of 40 and >= 2.5 x C.
# Base 2: at 4 req/s single-pod CPU samples reached 147m (59% of the 250m
# request), which would scale H2 (50% target) during warm-up; at 2 req/s CPU
# is 78-83m and Prometheus sees 2.13 req/s (< 5 req/s H3/K1 threshold).
AUTH_BASE_RATE=2
AUTH_PEAK_RATE=30
#
# shipping-rate-service (ladders 2026-10-05/06): C = 50 req/s (60 req/s on one
# pod collapses to 100% failures); B2 healthy at 140 req/s, 22% failures at 200.
# Peak 105 = 75% of 140. The ">= 2.5 x C" rule (125) conflicts with it; it exists
# to make B1 clearly overloaded, which already holds from 60 req/s, so the B2
# margin wins. Base 10: single-pod CPU 54m (22% of request), 10 req/s vs the
# 15 req/s/pod H3/K1 threshold.
SHIPPING_BASE_RATE=10
SHIPPING_PEAK_RATE=105

# SLOs (ms) for the window p95 and the SLO-violation seconds — fixed before
# the pilot. auth 1500 ~= closed-loop B2 spike p95 (1452 ms); shipping 1200 ~=
# 1.3 x closed-loop B2 p95 (917 ms), healthy open-loop p95 was 915-930 ms.
AUTH_SLO_MS=1500
SHIPPING_SLO_MS=1200

# Per-request timeout; a timed-out request is a failed request.
REQUEST_TIMEOUT=5s
# preAllocatedVUs = maxVUs = ceil(VU_FACTOR x peak rate x timeout)
VU_FACTOR=1.5

# k6 pod resources: request CPU, request memory, limit CPU, limit memory.
# Provisional; confirmed against measured k6 CPU/memory in the ladder.
K6_RESOURCES_AUTH=1000m,1Gi,2000m,4Gi
K6_RESOURCES_SHIPPING=1000m,1Gi,2000m,4Gi

# Seed for the within-rep-block run-order shuffle.
PILOT_SEED=20261005
